{
  "name": "url-shortener-stack",
  "private": true,
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=20.0.0"
  },
  "scripts": {
    "install:all": "concurrently \"bun install:backend\" \"bun install:frontend\"",
    "install:backend": "cd backend && bun install",
    "install:frontend": "cd frontend && bun install",
    "dev": "concurrently \"bun dev:backend\" \"bun dev:frontend\"",
    "dev:backend": "cd backend && bun run dev",
    "dev:frontend": "cd frontend && bun run dev",
    "build": "concurrently \"bun build:backend\" \"bun build:frontend\"",
    "build:backend": "cd backend && bun run build",
    "build:frontend": "cd frontend && bun run build",
    "lint": "concurrently \"bun lint:backend\" \"bun lint:frontend\"",
    "lint:backend": "cd backend && bun run lint",
    "lint:frontend": "cd frontend && bun run lint",
    "test": "concurrently \"bun test:backend\" \"bun test:frontend\"",
    "test:backend": "cd backend && bun run test",
    "test:frontend": "cd frontend && bun run test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.5.3"
  }
}